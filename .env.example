# Admin login for the Blog CMS.
# Generate ADMIN_PASSWORD_HASH with: pnpm hash-password "your-chosen-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional: where CMS data (posts.json + uploaded images) is stored.
# Defaults to ./data — must be a directory that survives redeploys.
# DATA_DIR=./data

# Optional: port the server listens on (defaults to 3000 in production).
# PORT=3000
