# Admin login for the Blog CMS.
# Generate ADMIN_PASSWORD_HASH with: pnpm hash-password "your-chosen-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase project used for blog posts, enquiries and uploaded images.
# Project URL and service_role key are under Settings > API in the Supabase dashboard.
# The service_role key bypasses Row Level Security — keep it server-side only, never
# expose it to the client or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: port the server listens on (defaults to 3000 in production).
# PORT=3000
