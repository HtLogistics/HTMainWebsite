# Random secret used to sign admin session cookies. At least 16 characters, and required in
# production. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase project used for blog posts, enquiries, uploaded images and admin sign-in.
# All three values are under Settings > API in the Supabase dashboard.
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security: keep it server-side only, never commit it.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admins are Supabase Auth users (Authentication > Users) whose app_metadata.role is "admin".
# See PROJECT-MEMORY.md for the one-line SQL that promotes a user.

# Optional: port the server listens on (defaults to 3000 in production).
# PORT=3000
